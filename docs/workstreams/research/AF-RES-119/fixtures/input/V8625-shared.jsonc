{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "customFormatTypes": false,
  },
  "width": 600,
  "height": 100,
  "data": {
    "values": [
      { "date": "2022-03-16" },
      { "date": "2022-04-16" },
      { "date": "2022-05-16" },
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "formatType": "customFormatter",
      },
    },
    "y": {
      "aggregate": "count",
    },
  },
}
