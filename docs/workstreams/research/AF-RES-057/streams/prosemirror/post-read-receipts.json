  "commits": [
    {
      "sha": "9bdb3774203d21e3ec14e621eb444524c629b7a3",
      "url": "https://github.com/ProseMirror/prosemirror-history/commit/9bdb3774203d21e3ec14e621eb444524c629b7a3",
      "created_at": "2019-02-19T10:26:02Z",
      "message": "Fix off-by-one error in history rebasing\n\nFIX: Fix a bug that corrupted selection data in the history when\napplying remote steps in some cases.\n\nIssue prosemirror/prosemirror#892"
    },
    {
      "sha": "c8f47adf3db77f2fe8756fb28451f8fa1c984958",
      "url": "https://github.com/ProseMirror/prosemirror-history/commit/c8f47adf3db77f2fe8756fb28451f8fa1c984958",
      "created_at": "2019-12-09T09:02:33Z",
      "message": "Don't combine appended transactions when the history was explicitly closed\n\nFIX: Fixes a regression where appeneded transactions were combined into the\nprevious history event even if that had been explicitly closed.\n\nIssue prosemirror/prosemirror#984"
    },
    {
      "sha": "f70697ef0cb6f06f0f9e0b719865d115f8c5f1c6",
      "url": "https://github.com/ProseMirror/prosemirror-history/commit/f70697ef0cb6f06f0f9e0b719865d115f8c5f1c6",
      "created_at": "2023-04-26T15:04:42Z",
      "message": "Always combine changes caused by the same composition\n\nFIX: Fix an issue where, if a composition moved the selection, it might get split\nacross multiple undo events.\n\nCloses https://github.com/ProseMirror/prosemirror/issues/1311"
    },
    {
      "sha": "ab0951c27445a2a154937e53c61ad87363b2d4ee",
      "url": "https://github.com/ProseMirror/prosemirror-history/commit/ab0951c27445a2a154937e53c61ad87363b2d4ee",
      "created_at": "2019-10-15T14:31:58Z",
      "message": "Never split appended transactions into a new group\n\nFIX: Prevents appended transactions from starting a new event group,\neven if they were created a while after the previous transaction.\n\nIssue prosemirror/prosemirror#984"
    }
  ],
