digraph Scope {
  node [color=black]
  edge [color=black, arrowhead=normal]
  subgraph alpha {
    node [color=red]
    edge [color=red, arrowhead=vee]
    shared [label="same"]
    a0 [label="same"]
    shared -> a0 [label="hop"]
  }
  subgraph beta {
    node [color=blue]
    edge [color=blue, arrowhead=dot]
    shared [label="same"]
    b0 [label="same"]
    shared -> b0 [label="hop"]
  }
  outside [label="same"]
  shared -> outside [label="hop"]
}
