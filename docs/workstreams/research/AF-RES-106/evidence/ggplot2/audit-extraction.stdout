{"case": "GG-X2", "edition": "old", "page": "reference/labs.html", "code": "p <- ggplot(mtcars, aes(mpg, wt, colour = cyl)) + geom_point()\np + labs(colour = \"Cylinders\")", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/labs-1.png", "relative_path": "reference/labs-1.png", "sha256": "050e91f6e15296e0113c28447d7e3436bfcc5735c6380711e5fea554139a6cb3", "git_blob": "f44826037d7e2cb29ebe7dbacf0ef83c0c632980", "bytes": 35627, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-labs.png.json", "accessed_utc": "2026-11-24T00:00:20.543162+00:00"}, "source": "man/labs.Rd", "author_sources": ["R/labels.r"]}
{"case": "GG-X2", "edition": "new", "page": "reference/labs.html", "code": "p <- ggplot(mtcars, aes(mpg, wt, colour = cyl)) + geom_point()\np + labs(colour = \"Cylinders\")", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/labs-1.png", "relative_path": "reference/labs-1.png", "sha256": "00752ed5b8088b9b0e6f8ccc1995b1becf989a47075bd909c25928638f6df708", "git_blob": "2b9c2129b457e851d36764c79a3573fcf6f2ba4c", "bytes": 35580, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-labs.png.json", "accessed_utc": "2026-11-24T00:00:28.038866+00:00"}, "source": "man/labs.Rd", "author_sources": ["R/labels.R"]}
{"case": "GG-X3", "edition": "old", "page": "reference/ggtheme.html", "code": "mtcars2 <- within(mtcars, {\n  vs <- factor(vs, labels = c(\"V-shaped\", \"Straight\"))\n  am <- factor(am, labels = c(\"Automatic\", \"Manual\"))\n  cyl  <- factor(cyl)\n  gear <- factor(gear)\n})\n\np1 <- ggplot(mtcars2) +\n  geom_point(aes(x = wt, y = mpg, colour = gear)) +\n  labs(\n    title = \"Fuel economy declines as weight increases\",\n    subtitle = \"(1973-74)\",\n    caption = \"Data from the 1974 Motor Trend US magazine.\",\n    tag = \"Figure 1\",\n    x = \"Weight (1000 lbs)\",\n    y = \"Fuel economy (mpg)\",\n    colour = \"Gears\"\n  )\n\np1 + theme_gray() # the default", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/ggtheme-1.png", "relative_path": "reference/ggtheme-1.png", "sha256": "a2603b02f305e949c7bc9ee3d9e9db1af08f672e2ac73fa77668b1e651e1d8a5", "git_blob": "8a435aac5751ee4854a06e1a24312db87e481dd8", "bytes": 63865, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-ggtheme.png.json", "accessed_utc": "2026-11-24T00:00:28.019009+00:00"}, "source": "man/ggtheme.Rd", "author_sources": ["R/theme-defaults.r"]}
{"case": "GG-X3", "edition": "new", "page": "reference/ggtheme.html", "code": "mtcars2 <- within(mtcars, {\n  vs <- factor(vs, labels = c(\"V-shaped\", \"Straight\"))\n  am <- factor(am, labels = c(\"Automatic\", \"Manual\"))\n  cyl  <- factor(cyl)\n  gear <- factor(gear)\n})\n\np1 <- ggplot(mtcars2) +\n  geom_point(aes(x = wt, y = mpg, colour = gear)) +\n  labs(\n    title = \"Fuel economy declines as weight increases\",\n    subtitle = \"(1973-74)\",\n    caption = \"Data from the 1974 Motor Trend US magazine.\",\n    tag = \"Figure 1\",\n    x = \"Weight (1000 lbs)\",\n    y = \"Fuel economy (mpg)\",\n    colour = \"Gears\"\n  )\n\np1 + theme_gray() # the default", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/ggtheme-1.png", "relative_path": "reference/ggtheme-1.png", "sha256": "3802caa10ac7317f4a26782e944efa52ac0b2b62fd7cafbf20f4b05f9de6652e", "git_blob": "68fc1fea6696e623764673cf95f928977e343944", "bytes": 63737, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-ggtheme.png.json", "accessed_utc": "2026-11-24T00:00:51.121024+00:00"}, "source": "man/ggtheme.Rd", "author_sources": ["R/theme-defaults.R"]}
{"case": "GG-S1", "edition": "old", "page": "reference/register_theme_elements.html", "code": "# Let's assume a package `ggxyz` wants to provide an easy way to add annotations to\n# plot panels. To do so, it registers a new theme element `ggxyz.panel.annotation`\nregister_theme_elements(\n  ggxyz.panel.annotation = element_text(color = \"blue\", hjust = 0.95, vjust = 0.05),\n  element_tree = list(ggxyz.panel.annotation = el_def(\"element_text\", \"text\"))\n)\n\n# Now the package can define a new coord that includes a panel annotation\ncoord_annotate <- function(label = \"panel annotation\") {\n  ggproto(NULL, CoordCartesian,\n    limits = list(x = NULL, y = NULL),\n    expand = TRUE,\n    default = FALSE,\n    clip = \"on\",\n    render_fg = function(panel_params, theme) {\n      element_render(theme, \"ggxyz.panel.annotation\", label = label)\n    }\n  )\n}\n\n# Example plot with this new coord\ndf <- data.frame(x = 1:3, y = 1:3)\nggplot(df, aes(x, y)) +\n  geom_point() +\n  coord_annotate(\"annotation in blue\")", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/register_theme_elements-1.png", "relative_path": "reference/register_theme_elements-1.png", "sha256": "cc4c447704262dde3de31f280c6621c3ce7d87104dd239f2daab6d0fe53ba5c8", "git_blob": "0f5a6ef245cf64cf9adc219713f8e9a77bd42d19", "bytes": 23521, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-register_theme_elements.png.json", "accessed_utc": "2026-11-24T00:00:51.151779+00:00"}, "source": "man/register_theme_elements.Rd", "author_sources": ["R/theme-elements.r"]}
{"case": "GG-S2", "edition": "old", "page": "reference/guide_axis.html", "code": "# plot with overlapping text\np <- ggplot(mpg, aes(cty * 100, hwy * 100)) +\n  geom_point() +\n  facet_wrap(vars(class))\n\n# axis guides can be customized in the scale_* functions or\n# using guides()\np + scale_x_continuous(guide = guide_axis(n.dodge = 2))", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/guide_axis-1.png", "relative_path": "reference/guide_axis-1.png", "sha256": "ce74ed24c8d0aec2d03dd6def20fb22ba3dec8a4bc38aff7ae58b25c6f05ecb3", "git_blob": "358c5d1674b27fc1e2ccf47015424f7c03fafe55", "bytes": 77864, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-guide_axis.png.json", "accessed_utc": "2026-11-24T00:00:58.655042+00:00"}, "source": "man/guide_axis.Rd", "author_sources": ["R/guides-axis.r"]}
{"case": "GG-S1", "edition": "new", "page": "reference/register_theme_elements.html", "code": "# Let's assume a package `ggxyz` wants to provide an easy way to add annotations to\n# plot panels. To do so, it registers a new theme element `ggxyz.panel.annotation`\nregister_theme_elements(\n  ggxyz.panel.annotation = element_text(color = \"blue\", hjust = 0.95, vjust = 0.05),\n  element_tree = list(ggxyz.panel.annotation = el_def(\"element_text\", \"text\"))\n)\n\n# Now the package can define a new coord that includes a panel annotation\ncoord_annotate <- function(label = \"panel annotation\") {\n  ggproto(NULL, CoordCartesian,\n    limits = list(x = NULL, y = NULL),\n    expand = TRUE,\n    default = FALSE,\n    clip = \"on\",\n    render_fg = function(panel_params, theme) {\n      element_render(theme, \"ggxyz.panel.annotation\", label = label)\n    }\n  )\n}\n\n# Example plot with this new coord\ndf <- data.frame(x = 1:3, y = 1:3)\nggplot(df, aes(x, y)) +\n  geom_point() +\n  coord_annotate(\"annotation in blue\")", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/register_theme_elements-1.png", "relative_path": "reference/register_theme_elements-1.png", "sha256": "34f8c70a9ca4761d5aa1d3718cec197e53cbd341c26b4298128b3bec343852a4", "git_blob": "74a7e74f4ac85c5791eecd4b0c511970fc7936b2", "bytes": 23567, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-register_theme_elements.png.json", "accessed_utc": "2026-11-24T00:00:58.531274+00:00"}, "source": "man/register_theme_elements.Rd", "author_sources": ["R/theme-elements.R"]}
{"case": "GG-S2", "edition": "new", "page": "reference/guide_axis.html", "code": "# plot with overlapping text\np <- ggplot(mpg, aes(cty * 100, hwy * 100)) +\n  geom_point() +\n  facet_wrap(vars(class))\n\n# axis guides can be customized in the scale_* functions or\n# using guides()\np + scale_x_continuous(guide = guide_axis(n.dodge = 2))", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/guide_axis-1.png", "relative_path": "reference/guide_axis-1.png", "sha256": "a25d7a128cb8f08e443fd2de528e2feaa6423c5750d16d693e98241ed3adf795", "git_blob": "e2113a6b1d5b1fa8ce0b6a1f0d553714030cc57a", "bytes": 77797, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-guide_axis.png.json", "accessed_utc": "2026-11-24T00:01:22.159020+00:00"}, "source": "man/guide_axis.Rd", "author_sources": ["R/guide-axis.R"]}
