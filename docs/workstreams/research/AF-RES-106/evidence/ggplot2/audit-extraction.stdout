{"case": "GG-M1", "edition": "old", "page": "reference/scale_shape.html", "code": "set.seed(596)\ndsmall <- diamonds[sample(nrow(diamonds), 100), ]\n\n(d <- ggplot(dsmall, aes(carat, price)) + geom_point(aes(shape = cut)))\n#> Warning: Using shapes for an ordinal variable is not advised", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/scale_shape-1.png", "relative_path": "reference/scale_shape-1.png", "sha256": "672a89564a27f017105e9a86d7c43e4e36d510da9211c53ca83d6d244966830a", "git_blob": "a6495c810d4ae94088d3e583423235bf07c3315a", "bytes": 49364, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-scale_shape.png.json", "accessed_utc": "2026-11-23T23:59:11.907247+00:00"}, "source": "man/scale_shape.Rd", "author_sources": ["R/scale-shape.r"]}
{"case": "GG-M2", "edition": "old", "page": "reference/geom_segment.html", "code": "b <- ggplot(mtcars, aes(wt, mpg)) +\n  geom_point()\n\ndf <- data.frame(x1 = 2.62, x2 = 3.57, y1 = 21.0, y2 = 15.0)\nb +\n geom_curve(aes(x = x1, y = y1, xend = x2, yend = y2, colour = \"curve\"), data = df) +\n geom_segment(aes(x = x1, y = y1, xend = x2, yend = y2, colour = \"segment\"), data = df)", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/geom_segment-1.png", "relative_path": "reference/geom_segment-1.png", "sha256": "e64d7eb79e6426dc205df57736c5c80c94de953bc7d264bc00ce6d4ec8d97aee", "git_blob": "a1544eaa36fef6e60d8b59f96cf2f4afb3e781a5", "bytes": 47856, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-geom_segment.png.json", "accessed_utc": "2026-11-23T23:59:11.227642+00:00"}, "source": "man/geom_segment.Rd", "author_sources": ["R/geom-segment.r", "R/geom-curve.r"]}
{"case": "GG-M1", "edition": "new", "page": "reference/scale_shape.html", "code": "set.seed(596)\ndsmall <- diamonds[sample(nrow(diamonds), 100), ]\n\n(d <- ggplot(dsmall, aes(carat, price)) + geom_point(aes(shape = cut)))\n#> Warning: Using shapes for an ordinal variable is not advised", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/scale_shape-1.png", "relative_path": "reference/scale_shape-1.png", "sha256": "532e6e2bff6baf564c5726ecb71fce0efcc2508e7fe81257db5f680e32d57b9d", "git_blob": "bdc56bf696d9e5c166b2c137c1220143c1cb4cea", "bytes": 48949, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-scale_shape.png.json", "accessed_utc": "2026-11-23T23:59:19.366937+00:00"}, "source": "man/scale_shape.Rd", "author_sources": ["R/scale-shape.R"]}
{"case": "GG-M2", "edition": "new", "page": "reference/geom_segment.html", "code": "b <- ggplot(mtcars, aes(wt, mpg)) +\n  geom_point()\n\ndf <- data.frame(x1 = 2.62, x2 = 3.57, y1 = 21.0, y2 = 15.0)\nb +\n geom_curve(aes(x = x1, y = y1, xend = x2, yend = y2, colour = \"curve\"), data = df) +\n geom_segment(aes(x = x1, y = y1, xend = x2, yend = y2, colour = \"segment\"), data = df)", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/392175bbb00b04025aa5d17a0c18b3896adeb40f/reference/geom_segment-1.png", "relative_path": "reference/geom_segment-1.png", "sha256": "0a32844fe54cc8dceb4ad86eacaf229da64a825bdf5c956afb496eae24e4c28b", "git_blob": "2156483e87d28741cd351f4f78fc8dbf3b3622a2", "bytes": 48059, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/new-asset-geom_segment.png.json", "accessed_utc": "2026-11-23T23:59:19.419158+00:00"}, "source": "man/geom_segment.Rd", "author_sources": ["R/geom-segment.R", "R/geom-curve.R"]}
{"case": "GG-G1", "edition": "old", "page": "reference/position_jitterdodge.html", "code": "set.seed(596)\ndsub <- diamonds[sample(nrow(diamonds), 1000), ]\nggplot(dsub, aes(x = cut, y = carat, fill = clarity)) +\n  geom_boxplot(outlier.size = 0) +\n  geom_point(pch = 21, position = position_jitterdodge())", "image": {"url": "https://raw.githubusercontent.com/tidyverse/ggplot2/57852124c86f770dd443fcf5064d30ea320a4731/reference/position_jitterdodge-1.png", "relative_path": "reference/position_jitterdodge-1.png", "sha256": "a8d74eab4a46746faafb97d07a02c00db5e532cf6f5a2d15b96cb4d16fe45c4c", "git_blob": "8694c00429beb5e7662d821ee2b872beb4c5213b", "bytes": 232805, "format": "PNG", "width": 1400, "height": 866, "receipt": "evidence/ggplot2/receipts/old-asset-position_jitterdodge.png.json", "accessed_utc": "2026-11-23T23:59:34.331081+00:00"}, "source": "man/position_jitterdodge.Rd", "author_sources": ["R/position-jitterdodge.R"]}
