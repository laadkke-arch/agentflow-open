    "mandatory_constraints": [
      {
        "id": "H1",
        "text": "Inspect the namespaces and filesystems of individual running containers."
      },
      {
        "id": "H2",
        "text": "Obtain debugging tools at troubleshooting time, without requiring prior pod/image configuration."
      },
      {
        "id": "H3",
        "text": "Respect admission control and audit logging and make the debugging activity visible through the API."
      },
      {
        "id": "H4",
        "text": "Support container runtimes through CRI, with reduced capabilities permitted."
      },
      {
        "id": "H5",
        "text": "Do not require administrative access to the node or inherently modify the running application image."
      },
      {
        "id": "H6",
        "text": "Make the complete debugging container specification inspectable by admission control."
      }
    ],
