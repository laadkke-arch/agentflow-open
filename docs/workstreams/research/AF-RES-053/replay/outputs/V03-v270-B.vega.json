    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "toNumber(datum[\"resilience\"])",
          "as": "resilience"
        },
        {
          "type": "filter",
          "expr": "datum[\"resilience\"] !== null && !isNaN(datum[\"resilience\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "toNumber(datum[\"Index\"])",
          "as": "Index"
        },
        {
          "type": "aggregate",
          "groupby": [],
          "ops": [
            "max"
          ],
          "fields": [
            "Index"
          ],
          "as": [
            "max_Index"
          ]
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "layer_0_marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_1"
      },
      "encode": {
        "update": {
          "fill": {
            "scale": "color",
            "field": "resilience"
          },
          "tooltip": {
            "signal": "format(datum[\"resilience\"], \".0f\")"
          },
          "x": {
            "scale": "x",
            "field": "resilience"
          },
          "x2": {
            "scale": "x",
            "value": 0
          },
          "y": {
            "scale": "y",
            "field": "section"
          },
          "height": {
            "scale": "y",
            "band": true
          }
        }
      }
    },
    {
      "name": "layer_1_marks",
      "type": "rule",
      "style": [
        "rule"
      ],
      "from": {
        "data": "data_2"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "red"
          },
          "x": {
            "scale": "x",
            "field": "max_Index"
          },
          "y": {
            "field": {
              "group": "height"
            }
          },
          "y2": {
            "value": 0
          },
          "strokeWidth": {
            "value": 3
          }
        }
      }
    }
