[{"sha":"0f2b4b235eb580590eaa744bf015d51e2e675afc","node_id":"MDY6Q29tbWl0MzI4Nzg4NDk5OjBmMmI0YjIzNWViNTgwNTkwZWFhNzQ0YmYwMTVkNTFlMmU2NzVhZmM=","commit":{"author":{"name":"Ralf Gommers","email":"ralf.gommers@gmail.com","date":"2021-02-21T15:42:22Z"},"committer":{"name":"Ralf Gommers","email":"ralf.gommers@gmail.com","date":"2021-02-21T15:42:22Z"},"message":"NEP: array API standard adoption\n\nThis NEP proposes adoption the array API standard\n(https://data-apis.github.io/array-api/latest/) in NumPy.\nThis will add a new `numpy.array_api` submodule containing that\nstandardized API.\n\nThe main purpose of this API is to be able to write code that is\nportable to other array/tensor libraries like CuPy, PyTorch,\nJAX, TensorFlow, Dask, and MXNet.","tree":{"sha":"1d120daa8c95d25c8e8fb674f33caa2ec35e4ef4","url":"https://api.github.com/repos/numpy/numpy/git/trees/1d120daa8c95d25c8e8fb674f33caa2ec35e4ef4"},"url":"https://api.github.com/repos/numpy/numpy/git/commits/0f2b4b235eb580590eaa744bf015d51e2e675afc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/numpy/numpy/commits/0f2b4b235eb580590eaa744bf015d51e2e675afc","html_url":"https://github.com/numpy/numpy/commit/0f2b4b235eb580590eaa744bf015d51e2e675afc","comments_url":"https://api.github.com/repos/numpy/numpy/commits/0f2b4b235eb580590eaa744bf015d51e2e675afc/comments","author":{"login":"rgommers","id":98330,"node_id":"MDQ6VXNlcjk4MzMw","avatar_url":"https://avatars.githubusercontent.com/u/98330?v=4","gravatar_id":"","url":"https://api.github.com/users/rgommers","html_url":"https://github.com/rgommers","followers_url":"https://api.github.com/users/rgommers/followers","following_url":"https://api.github.com/users/rgommers/following{/other_user}","gists_url":"https://api.github.com/users/rgommers/gists{/gist_id}","starred_url":"https://api.github.com/users/rgommers/starred{/owner}{/repo}","subscriptions_url":"https: