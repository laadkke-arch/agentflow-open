{
  "config": {
    "view": {
      "continuousWidth": 400,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "data/seattle-weather.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "color": {
      "condition": {
        "field": "weather",
        "type": "nominal",
        "param": "drag-brush"
      },
      "value": "lightgray"
    },
    "x": {
      "field": "date",
      "timeUnit": "month",
      "type": "ordinal"
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative"
    }
  },
  "params": [
    {
      "name": "drag-brush",
      "select": {
        "type": "interval",
        "encodings": [
          "x"
        ],
        "translate": false
      }
    }
  ]
}
